# ---------------------------------------------------------------------------
# PrepTrace — environment configuration
# Copy to .env (repo root) and fill in. The API and the batch evaluator read it.
# The web app only needs BACKEND_URL (see apps/web/.env.example).
# Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Database ---------------------------------------------------------------
# Leave empty in development to use an embedded MongoDB (persisted in .data/mongo).
# Required in production, e.g. a MongoDB Atlas free-tier connection string.
MONGODB_URI=

# --- Sessions / web ----------------------------------------------------------
# Random string, >= 32 chars in production:  openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=168
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
# lax (recommended, same-origin via the Next.js /api proxy) | strict | none (cross-site, requires HTTPS)
COOKIE_SAMESITE=lax
# Set true behind a reverse proxy (Render, Fly, etc.) so rate limiting sees real client IPs
TRUST_PROXY=false

# --- LLM (any provider with an OpenAI-compatible API) ------------------------
# gemini (free tier, default) | groq (free tier) | openrouter (free models) | openai | custom
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional overrides; presets fill these per provider.
#   gemini → https://generativelanguage.googleapis.com/v1beta/openai , gemini-2.5-flash
#   groq   → https://api.groq.com/openai/v1 , llama-3.3-70b-versatile
LLM_MODEL=
LLM_BASE_URL=
# Gemini 2.5 Flash: "none" disables thinking for faster, cheaper JSON steps. Leave empty for other providers.
LLM_REASONING_EFFORT=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192
# Free tiers throttle: bounded concurrency + request spacing + retry/backoff with jitter.
MAX_LLM_CONCURRENCY=2
LLM_MAX_RPM=10
LLM_MAX_RETRIES=5
LLM_TIMEOUT_MS=120000

# --- Public interview research (web search) ----------------------------------
# auto: Tavily if TAVILY_API_KEY, else Brave if BRAVE_SEARCH_API_KEY, else DuckDuckGo (keyless)
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARCH_MAX_RESULTS=6

# --- Crawling / fetching limits ----------------------------------------------
MAX_CRAWL_PAGES=10
MAX_CRAWL_DEPTH=2
CRAWL_CONCURRENCY=2
CRAWL_HOST_DELAY_MS=250
REQUEST_TIMEOUT_MS=10000
FETCH_MAX_BYTES=2000000
FETCH_MAX_RETRIES=3
# SSRF: private/loopback company URLs are rejected unless this is true (LOCAL DEV ONLY).
# The batch evaluator always runs in evaluation mode (localhost allowed, metadata IPs still blocked).
ALLOW_PRIVATE_URLS=false
RESEARCH_CACHE_TTL_HOURS=24

# --- Jobs / evaluator -----------------------------------------------------------
GENERATION_CONCURRENCY=2
EVAL_CASE_CONCURRENCY=2
EVAL_CASE_TIMEOUT_MS=480000

LOG_LEVEL=info
